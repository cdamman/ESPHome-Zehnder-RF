# Copy to secrets.yaml and fill in (secrets.yaml is gitignored).
wifi_ssid: "my-wifi"
wifi_password: "my-wifi-password"

# Home Assistant API encryption key (generated by ESPHome).
esphome_vmc_api_key: "base64-encoded-key"

esphome_vmc_ota_password: "ota-password"
esphome_vmc_ap_password: "fallback-access-point-password"
